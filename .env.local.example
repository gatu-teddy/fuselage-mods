# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable key (sb_publishable_…) — safe in the browser
SUPABASE_SERVICE_ROLE_KEY=            # secret key (sb_secret_…) — server only, never NEXT_PUBLIC_

# Cloudflare R2 (video uploads) — Dashboard → R2 → Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=                        # r2.dev URL for dev; a custom domain before launch
